FROM python:3.13-slim-trixie@sha256:48d884813cf44e927cf64c5529dd630dd3b18338c6dc727991eef9b71e934a20
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN python -m pip install --no-cache-dir --disable-pip-version-check --only-binary=:all: aiortc==1.16.0 aiohttp==3.14.5
COPY sma_rtc_receiver.py /qa/receiver.py
USER 65534:65534
ENTRYPOINT ["python","/qa/receiver.py"]
