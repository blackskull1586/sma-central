load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;
user www-data;
worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr crit;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format sma_safe '$remote_addr [$time_local] $request_method $uri $status $body_bytes_sent';
    access_log /dev/stdout sma_safe;
    sendfile on;
    server_tokens off;
    client_max_body_size 64k;
    limit_req_zone $binary_remote_addr zone=sma_login:1m rate=10r/m;
    # Accept forwarding headers only from the configured TLS proxy.
    map "$realip_remote_addr:$http_x_forwarded_proto" $sma_forwarded_proto {
        default $scheme;
        "__SMA_TRUSTED_PROXY__:https" https;
    }
    upstream sma_backend { server backend:8000; keepalive 8; }
    upstream sma_realtime { server realtime-gateway:8090; keepalive 8; }

    server {
        listen 8080;
        server_name _;
        set_real_ip_from __SMA_TRUSTED_PROXY__;
        real_ip_header X-Real-IP;
        add_header X-Content-Type-Options nosniff always;

        location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
        location = /assets/central.webmanifest {
            types { }
            default_type application/manifest+json;
            alias /srv/sma/web/central.webmanifest;
        }
        location ^~ /assets/ {
            alias /srv/sma/web/;
            autoindex off;
            # Only static assets may be served; legacy HTML and the shared catalog stay inaccessible.
            location ~* \.(?:html|json|py|conf)$ { return 404; }
        }
        location = /favicon.ico { alias /srv/sma/web/icone.ico; }
        location ^~ /internal/ { return 404; }
        location = /internal { return 404; }
        location ^~ /rtc/ {
            access_log off;
            include /etc/nginx/sma-proxy.conf;
            proxy_buffering off;
            proxy_pass http://sma_realtime;
        }

        location = /_sma_hls_auth {
            internal;
            proxy_pass http://sma_backend/internal/hls/;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Forwarded-Proto $sma_forwarded_proto;
            include /etc/nginx/sma-internal-header.conf;
        }
        location /hls/ {
            auth_request /_sma_hls_auth;
            alias /var/www/hls/;
            types { application/vnd.apple.mpegurl m3u8; video/mp2t ts; }
            add_header Cache-Control "no-store, private" always;
            autoindex off;
        }
        location = /login/ {
            limit_req zone=sma_login burst=24 nodelay;
            limit_req_status 429;
            include /etc/nginx/sma-proxy.conf;
            proxy_pass http://sma_backend;
        }
        location / {
            include /etc/nginx/sma-proxy.conf;
            proxy_pass http://sma_backend;
        }
    }

    # The Caddy edge uses this unpublished listener for certificate and HTTP admission.
    server {
        listen 8092;
        server_name _;
        access_log off;
        allow __SMA_TRUSTED_PROXY__;
        deny all;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Content-Length "";
        proxy_set_header Host backend;
        include /etc/nginx/sma-internal-header.conf;
        location = /permit {
            proxy_pass http://sma_backend/internal/domains/permit/;
        }
        location = /check-host {
            set $args "domain=$host&access=1";
            proxy_pass http://sma_backend/internal/domains/permit/;
        }
        location / { return 404; }
    }

    # Only the RTMP process inside this container can call this HTTP listener.
    server {
        listen 127.0.0.1:8081;
        server_name localhost;
        access_log off;
        location /relay/ {
            proxy_pass http://sma_backend/internal/relay/;
            proxy_set_header Host backend;
            include /etc/nginx/sma-internal-header.conf;
        }
        location /rtmp/ {
            proxy_pass http://sma_backend/internal/rtmp/;
            proxy_set_header Host backend;
            include /etc/nginx/sma-internal-header.conf;
        }
        location / { return 404; }
    }
}

rtmp {
    access_log off;
    chunk_size 4096;
    out_queue 256;
    out_cork 1;
    ping 15s;
    ping_timeout 10s;
    server {
        listen 1935;
        application live {
            live on;
            record off;
            deny play all;
            drop_idle_publisher 15s;
            push_reconnect 1s;
            session_relay on;
            on_publish http://127.0.0.1:8081/rtmp/publish/;
            # Give every authorized redirect a unique local stream, even when
            # multiple devices publish the exact same external name/key.
            notify_relay_redirect on;
            on_update http://127.0.0.1:8081/rtmp/update/;
            on_publish_done http://127.0.0.1:8081/rtmp/done/;
            notify_method post;
            notify_update_timeout 2s;
            notify_update_strict on;
            hls off;
        }
    }
    # Only this container's authenticated relay reaches the HLS/RTC stage.
    server {
        listen 127.0.0.1:1936;
        application live {
            live on;
            record off;
            deny play all;
            drop_idle_publisher 15s;
            push_reconnect 1s;
            session_relay on;
            on_publish http://127.0.0.1:8081/relay/publish/;
            on_update http://127.0.0.1:8081/relay/update/;
            on_publish_done http://127.0.0.1:8081/relay/done/;
            notify_method post;
            notify_update_timeout 2s;
            notify_update_strict on;
            hls on;
            hls_path /var/www/hls;
            hls_fragment 1s;
            hls_playlist_length 12s;
            hls_continuous on;
            hls_cleanup on;
            hls_fragment_naming system;
        }
    }
}
